# Plum 环境变量配置示例
# 复制为 .env 并填入实际值（.env 已被 .gitignore 排除）

# === Broker / QMT 交易网关 ===
PLUM_BROKER_PROVIDER=qmt
PLUM_BROKER_QMT_PATH=C:/path/to/userdata_mini
PLUM_BROKER_ACCOUNT_ID=你的账户ID
PLUM_BROKER_SESSION_ID=9527
PLUM_BROKER_TRADE_ENV=real

# === 数据库路径（可选） ===
# PLUM_DATA_DB_PATH=./data

# === 回测引擎（可选） ===
# PLUM_ENGINE_INITIAL_CAPITAL=1000000
# PLUM_ENGINE_BACKTEST_START=2020-01-01
# PLUM_ENGINE_BACKTEST_END=2024-12-31

# === 日志（可选） ===
# PLUM_LOGGING_LEVEL=INFO
